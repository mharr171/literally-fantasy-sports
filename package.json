{
  "name": "literally-fantasy-sports",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @lfs/db generate",
    "test:db": "pnpm --filter @lfs/db test:db"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
